# Real-Time Vision System Configuration
# Copy this file to .env and update values as needed

# ===========================================
# APPLICATION SETTINGS
# ===========================================
APP_NAME=Real-Time Vision System
APP_ENV=development  # development, production
DEBUG=false
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL

# ===========================================
# DASHBOARD SETTINGS
# ===========================================
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=5050
DASHBOARD_SECRET_KEY=change-this-to-a-random-secret-key-in-production
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=changeme
DASHBOARD_SESSION_TIMEOUT=3600  # seconds

# ===========================================
# CAMERA/SOURCE SETTINGS
# ===========================================
SOURCE_TYPE=video  # camera, video
SOURCE_VIDEO_PATH=test_video.avi
SOURCE_CAMERA_INDEX=0
SOURCE_WIDTH=1280
SOURCE_HEIGHT=720
SOURCE_FPS=60
SOURCE_BACKEND=CAP_ANY
SOURCE_RECONNECT_ATTEMPTS=5
SOURCE_RECONNECT_DELAY=2.0

# ===========================================
# DETECTOR SETTINGS
# ===========================================
DETECTOR_MODEL_PATH=yolov8n.pt
DETECTOR_CONFIDENCE_THRESHOLD=0.5
DETECTOR_IOU_THRESHOLD=0.45
DETECTOR_DEVICE=null  # null, cpu, cuda
DETECTOR_IMG_SIZE=640

# ===========================================
# TRACKER SETTINGS
# ===========================================
TRACKER_TYPE=iou  # iou, bytetrack
TRACKER_MAX_LOST_FRAMES=30
TRACKER_IOU_THRESHOLD=0.3

# ===========================================
# PIPELINE SETTINGS
# ===========================================
PIPELINE_WINDOW_NAME=Real-Time Vision System
PIPELINE_SHOW_FPS=true

# ===========================================
# EVENT SETTINGS
# ===========================================
EVENTS_LOG_EVENTS=true

# ===========================================
# DATABASE SETTINGS (optional, for future use)
# ===========================================
# DATABASE_URL=sqlite:///./vision_system.db
# DATABASE_POOL_SIZE=5

# ===========================================
# SECURITY SETTINGS
# ===========================================
# API_KEY_HEADER=X-API-Key
# API_KEY=your-secret-api-key-here

# ===========================================
# MONITORING & METRICS
# ===========================================
# ENABLE_METRICS=false
# METRICS_PORT=9090

# ===========================================
# DOCKER & DEPLOYMENT
# ===========================================
# GPU_ENABLED=false
# CONTAINER_NAME=vision-system
